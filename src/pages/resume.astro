---
import Base from "../layouts/Base.astro";
import { SITE, EXPERIENCE, EDUCATION, CREDENTIALS, LEADERSHIP, STACK } from "../data/site";
import { sorted, STATUS } from "../data/projects";
const title = "Résumé: Mahmud Sani Madobi, AI systems engineer";
const description = "Résumé of Mahmud Sani Madobi: AI systems engineer, software architect and founder of MeerTech Ltd. Experience, selected systems, stack, education and credentials.";
const crumbs = [{ name: "Home", href: "/" }, { name: "Résumé", href: "/resume" }];
const top = sorted.filter((p) => p.status === "production" || p.status === "substantial").slice(0, 9);
---
<Base title={title} description={description} og="resume" crumbs={crumbs}>
  <section class="rs-bar no-print"><div class="wrap">
    <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Résumé</li></ol>
    <div class="btn-row"><a class="btn btn-primary" href="/mahmud-sani-madobi-resume.pdf" download>Download PDF <span aria-hidden="true">↓</span></a><button class="btn" type="button" data-print>Print</button></div>
  </div></section>
  <article class="rs"><div class="wrap wrap-narrow">
    <header>
      <h1>{SITE.name}</h1>
      <p class="rs-role">{SITE.role} · {SITE.title}</p>
      <p class="rs-contact mono">{SITE.location} · <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.origin}>sm.meertech.tech</a> · <a href={SITE.github}>github.com/MEERTECHLTD</a> · <a href={SITE.linkedin}>linkedin.com/in/mahmud-madobi</a></p>
    </header>
    <section><h2>Profile</h2>
      <p>I design, build and run production systems for energy, finance and data, for places where the power, the network and the inputs are unreliable. I work at the systems layer: double-entry ledgers with idempotent writes, offline-first sync, row-level security, and AI kept inside deterministic boundaries. As founder of MeerTech Ltd I am responsible for the architecture of its products and client systems and for keeping them running.</p>
    </section>
    <section><h2>Experience</h2>
      {EXPERIENCE.map((r) => <div class="rs-item"><div class="rs-h"><h3>{r.role}, {r.org}</h3><span class="mono">{r.when}</span></div><p>{r.note}</p></div>)}
    </section>
    <section><h2>Selected systems</h2>
      <ul class="rs-sys">{top.map((p) => <li><b>{p.name}</b> <span class="mono">({STATUS[p.status].label.toLowerCase()})</span>. {p.summary} <span class="rs-stack">{p.stack.slice(0, 5).join(", ")}.</span></li>)}</ul>
      <p class="rs-note">Statuses are stated from evidence. Architecture and decisions for each: sm.meertech.tech/work</p>
    </section>
    <section><h2>Technical stack</h2>
      <dl class="rs-stk">{STACK.map((g) => <div><dt>{g.group}</dt><dd>{g.items.map((i) => i.name).join(", ")}</dd></div>)}</dl>
    </section>
    <section class="rs-two">
      <div><h2>Education</h2><ul>{EDUCATION.map((e) => <li><b>{e.what}</b>, {e.where} <span class="mono">{e.when}</span></li>)}</ul></div>
      <div><h2>Credentials and memberships</h2><ul>{CREDENTIALS.map((e) => <li><b>{e.what}</b>, {e.where} <span class="mono">{e.when}</span></li>)}{LEADERSHIP.map((e) => <li><b>{e.role}</b>, {e.org} <span class="mono">{e.when}</span></li>)}</ul></div>
    </section>
    <section><h2>Languages</h2><p>English and Hausa.</p></section>
  </div></article>
  <script>document.querySelector("[data-print]")?.addEventListener("click", () => window.print());</script>
</Base>
<style>
  .rs-bar { padding-top: calc(var(--header-h) + var(--s7)); }
  .rs-bar .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s4); max-width: calc(760px + var(--gutter) * 2); }
  .rs { padding-block: var(--s7) var(--s9); }
  .rs h1 { font-size: clamp(2.75rem, 6vw, 4.5rem); }
  .rs-role { font-size: var(--t-lead); margin-top: var(--s3); }
  .rs-contact { margin-top: var(--s4); font-size: var(--t-micro); text-transform: none; letter-spacing: 0.02em; color: var(--ink-2); line-height: 1.9; }
  .rs-contact a { text-decoration: underline; text-decoration-color: var(--line-2); }
  .rs section { margin-top: var(--s7); }
  .rs h2 { font-family: var(--mono); font-size: var(--t-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--mark); padding-bottom: var(--s2); border-bottom: 1px solid var(--line-2); margin-bottom: var(--s4); line-height: 1.4; }
  .rs p, .rs li, .rs dd { font-size: 0.9688rem; line-height: 1.6; }
  .rs-item + .rs-item { margin-top: var(--s4); }
  .rs-h { display: flex; justify-content: space-between; gap: var(--s4); align-items: baseline; }
  .rs h3 { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.005em; }
  .rs .mono { font-size: var(--t-micro); color: var(--ink-3); text-transform: none; white-space: nowrap; }
  .rs .rs-contact { white-space: normal; overflow-wrap: anywhere; }
  .rs-sys li + li { margin-top: var(--s2); }
  .rs-stack { color: var(--ink-3); }
  .rs-note { margin-top: var(--s3); color: var(--ink-3); font-size: var(--t-small); }
  .rs-stk div { display: grid; grid-template-columns: 190px 1fr; gap: var(--s4); padding: 5px 0; }
  .rs-stk dt { font-weight: 600; font-size: 0.9375rem; }
  .rs-two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s7); }
  .rs-two li + li { margin-top: var(--s2); }
  @media (max-width: 640px) { .rs-two, .rs-stk div { grid-template-columns: 1fr; gap: 2px; } .rs-two { gap: 0; } .rs-two > div + div { margin-top: var(--s7); } .rs-h { flex-direction: column; gap: 0; } }
  @media print {
    .rs { padding: 0; } .rs .wrap { padding: 0; max-width: none; }
    .rs h1 { font-size: 30pt; color: #000; } .rs h2 { color: #b3260a; border-color: #bbb; } .rs p, .rs li, .rs dd, .rs h3 { color: #111; font-size: 9.6pt; } .rs h3 { font-size: 10.4pt; }
    .rs-role { font-size: 11.5pt; color: #111; } .rs-contact, .rs .mono, .rs-stack, .rs-note { color: #444; font-size: 8pt; }
    .rs section { margin-top: 13pt; } .rs-item, .rs-sys li, .rs-two > div, .rs-stk div { break-inside: avoid; } .rs h2 { break-after: avoid; }
    @page { margin: 15mm 16mm; }
  }
</style>
