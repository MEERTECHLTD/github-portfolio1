---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
const notes = (await getCollection("writing")).sort((a, b) => +b.data.date - +a.data.date);
const title = "Writing: engineering notes by Mahmud Sani Madobi";
const description = "Engineering notes on agentic AI, financial infrastructure, offline-first systems and secure design, drawn from systems that shipped.";
const crumbs = [{ name: "Home", href: "/" }, { name: "Writing", href: "/writing" }];
const topics = ["Agentic AI", "AI safety", "Backend architecture", "Distributed systems", "Financial engineering", "Energy infrastructure", "IoT and edge", "GIS and agricultural intelligence", "Offline-first engineering", "Secure system design"];
---
<Base title={title} description={description} og="writing" crumbs={crumbs} pageType="CollectionPage">
  <section class="phero"><div class="wrap">
    <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Writing</li></ol>
    <h1>Notes from systems that <span class="i">shipped.</span></h1>
    <p class="lead">I write about decisions I have had to live with in production. No invented results, no borrowed citations: where a note mentions a system, it is one on this site.</p>
  </div></section>
  <section class="sec"><div class="wrap grid">
    <ol class="c-8 list">
      {notes.map((n) => <li><a href={`/writing/${n.id}`}><span class="mono faint">{n.data.category} · {n.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })} · {Math.max(2, Math.round((n.body ?? "").split(/\s+/).length / 220))} min</span><span class="serif t">{n.data.title}</span><span class="muted">{n.data.description}</span></a></li>)}
    </ol>
    <aside class="c-4"><p class="label">What I write about</p><ul class="chips" style="margin-top: var(--s4)">{topics.map((t) => <li>{t}</li>)}</ul>
      <p class="muted" style="margin-top: var(--s6); font-size: var(--t-small)">MeerTech's engineering team also publishes field notes on reporting absence, forecasting against persistence and verifiable AI at <a class="link" href="https://www.meertech.tech/research" rel="noopener">meertech.tech/research</a>.</p></aside>
  </div></section>
</Base>
<style>
  .list { border-top: 1px solid var(--line-2); }
  .list a { display: grid; gap: var(--s3); padding: var(--s7) 0; border-bottom: 1px solid var(--line); transition: padding 300ms var(--ease); }
  .t { font-size: clamp(2rem, 3.4vw + 0.8rem, 3.75rem); line-height: 1.02; }
  .list a:hover { padding-left: var(--s4); } .list a:hover .t { color: var(--mark); }
</style>
