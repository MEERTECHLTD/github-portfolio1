# Canonical site URL (no trailing slash). Used for metadata, OG, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://sm.meertech.tech

# Optional: a GitHub token raises the public API rate limit for the live
# profile-stats fetch (lib/github.ts). A read-only / no-scope token is fine.
# Without it the site falls back to curated static stats and still works.
# GITHUB_TOKEN=
