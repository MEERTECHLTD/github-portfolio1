# Canonical site URL (no trailing slash). Used as the metadata base.
NEXT_PUBLIC_SITE_URL=https://sm.meertech.tech

# Optional: a GitHub token raises the public API rate limit for the live
# footprint fetch (lib/github.ts). A read-only token with no scopes is enough.
# Without it, or if GitHub is unreachable, the site uses the measured snapshot
# in content/github.json and still works.
# GITHUB_TOKEN=
